<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.lingnow.biz.menu.mapper.SysMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cc.lingnow.biz.menu.entity.SysMenu">
        <id column="menu_id" property="menuId"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_type" property="menuType"/>
        <result column="icon" property="icon"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="permission" property="permission"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="visible" property="visible"/>
        <result column="is_cache" property="isCache"/>
        <result column="status" property="status"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
        <result column="remark" property="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        menu_id, parent_id, menu_name, menu_type, icon, path, component, permission, sort_order, visible, is_cache, status, create_by, create_time, update_by, update_time, del_flag, remark
    </sql>

    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_menu
        WHERE status = 1 AND visible = 1
        ORDER BY sort_order ASC
    </select>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_menu
        WHERE parent_id = #{parentId} AND status = 1 AND visible = 1
        ORDER BY sort_order ASC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT DISTINCT m.*
        FROM sys_menu m
                 LEFT JOIN sys_role_menu rm ON m.menu_id = rm.menu_id
                 LEFT JOIN sys_user_role ur ON rm.role_id = ur.role_id
                 LEFT JOIN sys_role r ON r.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND m.status = 1
          AND m.visible = 1
          AND r.status = 1
          AND r.del_flag = 0
          AND m.del_flag = 0
        ORDER BY m.sort_order ASC
    </select>

</mapper>
