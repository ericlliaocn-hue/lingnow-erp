# LingNow ERP environment example.
# Copy to .env before running docker compose, then replace every CHANGE_ME value.
#
# Two runtime modes are supported:
# 1. Full Compose mode:
#    docker compose --env-file .env -f docker-compose.yml up -d --build
#    This starts MySQL, Redis, Admin, App, and Web containers.
# 2. Host dependency mode, recommended for local validation to save disk space:
#    cp docker-compose.host.example.yml docker-compose.host.yml
#    docker compose --env-file .env -f docker-compose.host.yml up -d --build
#    This starts only Admin, App, and Web containers. MySQL and Redis stay on the host.

COMPOSE_PROJECT_NAME=lingnow-erp
TZ=Asia/Shanghai

# Full Compose mode: containerized MySQL and Redis.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=lingnow_erp
MYSQL_USER=lingnow
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

LINGNOW_DB_URL=jdbc:mysql://mysql:3306/lingnow_erp?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
LINGNOW_DB_USERNAME=lingnow
LINGNOW_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
LINGNOW_REDIS_HOST=redis
LINGNOW_REDIS_PORT=6379
LINGNOW_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Host dependency mode: host MySQL and Redis, reached from Docker by host.docker.internal.
HOST_LINGNOW_DB_URL=jdbc:mysql://host.docker.internal:3306/lingnow_erp?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
HOST_LINGNOW_DB_USERNAME=CHANGE_ME_HOST_DB_USER
HOST_LINGNOW_DB_PASSWORD=CHANGE_ME_HOST_DB_PASSWORD
HOST_LINGNOW_REDIS_HOST=host.docker.internal
HOST_LINGNOW_REDIS_PORT=CHANGE_ME_HOST_REDIS_PORT
HOST_LINGNOW_REDIS_PASSWORD=CHANGE_ME_HOST_REDIS_PASSWORD

LINGNOW_ADMIN_REDIS_DATABASE=1
LINGNOW_APP_REDIS_DATABASE=11
LINGNOW_FILE_BASE_PATH=/data/lingnow/files/
LINGNOW_FILE_DOMAIN=/files/
LINGNOW_LOG_LEVEL=INFO
LINGNOW_APP_LOG_LEVEL=INFO
LINGNOW_API_DOC_ENABLED=false

ADMIN_SERVER_PORT=6060
APP_SERVER_PORT=6061

NGINX_HTTP_PORT=8090
